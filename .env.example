# GS Panel Development Environment Configuration
# Copy this file to .env and adjust values as needed

# Server Configuration
GS_PANEL_SERVER_HOST=0.0.0.0
GS_PANEL_SERVER_PORT=8080

# Database
GS_PANEL_DATABASE_PATH=./data/panel.db

# Storage Paths
GS_PANEL_STORAGE_SERVERS=./data/servers
GS_PANEL_STORAGE_BACKUPS=./data/backups
GS_PANEL_STORAGE_LOGS=./data/logs

# Docker Configuration
# For Windows with Docker Desktop:
# GS_PANEL_DOCKER_SOCKET=//./pipe/docker_engine
# For Linux/Mac:
GS_PANEL_DOCKER_SOCKET=/var/run/docker.sock

# Security (generate strong random values for production)
# GS_PANEL_SESSION_SECRET=your-secret-key-here
