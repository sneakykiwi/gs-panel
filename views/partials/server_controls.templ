package partials

import (
	"github.com/sneakykiwi/gs-panel/internal/models"
	"github.com/sneakykiwi/gs-panel/views/components"
)

templ ServerControls(server *models.Server, isAdmin bool) {
	<div id="server-controls-container" class="flex flex-wrap gap-3">
		if server.Status == models.ServerStatusRunning {
			<button 
				hx-post={ "/servers/" + server.ID + "/stop" }
				hx-swap="none"
				hx-target="#server-controls-container"
				@click="loading = true; action = 'stop'"
				@htmx:after-request={ "loading = false; action = ''; showToast('success', 'Server stopped successfully'); htmx.ajax('GET', '/servers/" + server.ID + "/controls', {target: '#server-controls-container', swap: 'outerHTML'})" }
				@htmx:response-error="loading = false; action = ''"
				:disabled="loading"
				class="bg-red-600 hover:bg-red-700 disabled:opacity-50 disabled:cursor-not-allowed text-white px-6 py-2 rounded transition flex items-center gap-2"
			>
				<span x-show="loading && action === 'stop'" x-cloak>
					@components.ButtonSpinner()
				</span>
				<span x-show="!loading || action !== 'stop'">Stop Server</span>
				<span x-show="loading && action === 'stop'" x-cloak>Stopping...</span>
			</button>
			<button 
				hx-post={ "/servers/" + server.ID + "/restart" }
				hx-swap="none"
				hx-target="#server-controls-container"
				@click="loading = true; action = 'restart'"
				@htmx:after-request={ "loading = false; action = ''; showToast('success', 'Server restarted successfully'); htmx.ajax('GET', '/servers/" + server.ID + "/controls', {target: '#server-controls-container', swap: 'outerHTML'})" }
				@htmx:response-error="loading = false; action = ''"
				:disabled="loading"
				class="bg-yellow-600 hover:bg-yellow-700 disabled:opacity-50 disabled:cursor-not-allowed text-white px-6 py-2 rounded transition flex items-center gap-2"
			>
				<span x-show="loading && action === 'restart'" x-cloak>
					@components.ButtonSpinner()
				</span>
				<span x-show="!loading || action !== 'restart'">Restart Server</span>
				<span x-show="loading && action === 'restart'" x-cloak>Restarting...</span>
			</button>
		} else {
			<button 
				hx-post={ "/servers/" + server.ID + "/start" }
				hx-swap="none"
				hx-target="#server-controls-container"
				@click="loading = true; action = 'start'"
				@htmx:after-request={ "loading = false; action = ''; showToast('success', 'Server started successfully'); htmx.ajax('GET', '/servers/" + server.ID + "/controls', {target: '#server-controls-container', swap: 'outerHTML'})" }
				@htmx:response-error="loading = false; action = ''"
				:disabled="loading"
				class="bg-green-600 hover:bg-green-700 disabled:opacity-50 disabled:cursor-not-allowed text-white px-6 py-2 rounded transition flex items-center gap-2"
			>
				<span x-show="loading && action === 'start'" x-cloak>
					@components.ButtonSpinner()
				</span>
				<span x-show="!loading || action !== 'start'">Start Server</span>
				<span x-show="loading && action === 'start'" x-cloak>Starting...</span>
			</button>
		}
		
		<!-- Edit Button -->
		<a 
			href={ templ.URL("/servers/" + server.ID + "/edit") }
			class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded transition inline-block"
		>
			Edit Settings
		</a>

		<!-- View Template Button -->
		<a
			href={ templ.URL("/servers/" + server.ID + "/template") }
			class="bg-gray-600 hover:bg-gray-700 text-white px-6 py-2 rounded transition inline-block"
		>
			View Template
		</a>

		if isAdmin {
			<button 
				hx-delete={ "/servers/" + server.ID }
				hx-confirm="Are you sure you want to delete this server?"
				@click="loading = true; action = 'delete'"
				:disabled="loading"
				class="bg-gray-600 hover:bg-gray-700 disabled:opacity-50 disabled:cursor-not-allowed text-white px-6 py-2 rounded transition ml-auto flex items-center gap-2"
			>
				<span x-show="loading && action === 'delete'" x-cloak>
					@components.ButtonSpinner()
				</span>
				<span>Delete Server</span>
			</button>
		}
	</div>
}
