package admin

import (
    "github.com/sneakykiwi/gs-panel/internal/models"
    "github.com/sneakykiwi/gs-panel/internal/services"
    "github.com/sneakykiwi/gs-panel/views/layouts"
    "github.com/sneakykiwi/gs-panel/views/components"
)

templ TemplateEditPage(user *models.User, template services.GameTemplate, yamlContent string, errorMsg string) {
    @layouts.Base("Edit Template - " + template.Name, user) {
       <div class="flex h-screen">
          @components.Sidebar(user)

          <main class="flex-1 p-8 overflow-auto">
             <div class="mb-6">
                <a href="/admin/templates" class="text-gray-400 hover:text-white text-sm">
                   ← Back to Templates
                </a>
             </div>

             <div class="flex justify-between items-center mb-8">
                <div>
                   <h1 class="text-3xl font-bold">Edit Template</h1>
                   <p class="text-gray-400">{ template.Name } ({ template.ID })</p>
                </div>
             </div>

             @TemplateYAMLForm(template.ID, yamlContent, errorMsg, "/admin/templates/" + template.ID + "/edit", "Save Changes")
          </main>
       </div>
    }
}

templ TemplateClonePage(user *models.User, source services.GameTemplate, yamlContent string, errorMsg string) {
    @layouts.Base("Clone Template - " + source.Name, user) {
       <div class="flex h-screen">
          @components.Sidebar(user)

          <main class="flex-1 p-8 overflow-auto">
             <div class="mb-6">
                <a href="/admin/templates" class="text-gray-400 hover:text-white text-sm">
                   ← Back to Templates
                </a>
             </div>

             <div class="flex justify-between items-center mb-8">
                <div>
                   <h1 class="text-3xl font-bold">Clone Template</h1>
                   <p class="text-gray-400">Creating new template from { source.Name }</p>
                </div>
             </div>

             <div class="mb-6 bg-blue-500/20 border border-blue-500 text-blue-300 px-4 py-3 rounded">
                <p class="font-medium">ℹ️ Cloning a Template</p>
                <p class="text-sm">Change the <code class="bg-gray-700 px-1 rounded">id</code> and <code class="bg-gray-700 px-1 rounded">name</code> fields to create your custom version.</p>
             </div>

             @TemplateYAMLForm(source.ID, yamlContent, errorMsg, "/admin/templates/" + source.ID + "/clone", "Create Clone")
          </main>
       </div>
    }
}

templ TemplateCreatePage(user *models.User, yamlContent string, errorMsg string) {
    @layouts.Base("New Template", user) {
       <div class="flex h-screen">
          @components.Sidebar(user)

          <main class="flex-1 p-8 overflow-auto">
             <div class="mb-6">
                <a href="/admin/templates" class="text-gray-400 hover:text-white text-sm">
                   ← Back to Templates
                </a>
             </div>

             <h1 class="text-3xl font-bold mb-8">New Template</h1>

             @TemplateYAMLForm("", yamlContent, errorMsg, "/admin/templates/new", "Create Template")
          </main>
       </div>
    }
}

templ TemplateYAMLForm(templateID string, yamlContent string, errorMsg string, action string, submitText string) {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.12/codemirror.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.12/theme/dracula.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.12/codemirror.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.12/mode/yaml/yaml.min.js"></script>
    <style>
      .CodeMirror {
        border: 1px solid #374151;
        height: auto;
        resize: vertical;
        font-family: monospace;
        font-size: 0.875rem;
      }
    </style>
    <form id="yaml-form" method="POST" action={ templ.URL(action) } class="max-w-4xl">
       if errorMsg != "" {
          <div class="mb-6 bg-red-500/20 border border-red-500 text-red-300 px-4 py-3 rounded">
             { errorMsg }
          </div>
       }

       <div class="mb-6">
          <label class="block text-sm font-medium mb-2">YAML Configuration</label>
          <textarea
             id="yaml-editor"
             name="yaml_content"
             rows="30"
             class="w-full px-4 py-3 bg-gray-900 border border-gray-700 rounded font-mono text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 resize-y"
             spellcheck="false"
          >{ yamlContent }</textarea>
          <p class="text-gray-500 text-sm mt-2">
             Edit the YAML configuration directly. Required fields: <code class="bg-gray-700 px-1 rounded">id</code>, <code class="bg-gray-700 px-1 rounded">docker_image</code>
          </p>
       </div>

       <div class="flex gap-3">
          <button
             type="submit"
             class="bg-green-600 hover:bg-green-700 text-white px-6 py-2 rounded transition"
          >
             { submitText }
          </button>
          <a
             href="/admin/templates"
             class="bg-gray-600 hover:bg-gray-700 text-white px-6 py-2 rounded transition inline-block"
          >
             Cancel
          </a>
       </div>
    </form>
    <script>
      var editor = CodeMirror.fromTextArea(document.getElementById("yaml-editor"), {
        lineNumbers: true,
        mode: "yaml",
        theme: "dracula",
        tabSize: 2,
        indentWithTabs: false,
        extraKeys: {"Tab": "indentMore", "Shift-Tab": "indentLess"},
        viewportMargin: Infinity
      });
      editor.setSize("100%", null); // Auto height based on content
      document.getElementById("yaml-form").onsubmit = function() {
        editor.save();
      };
    </script>
}