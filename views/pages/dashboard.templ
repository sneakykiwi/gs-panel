package pages

import (
	"strconv"

	"github.com/a-h/templ"
	"github.com/sneakykiwi/gs-panel/internal/models"
	"github.com/sneakykiwi/gs-panel/views/components"
	"github.com/sneakykiwi/gs-panel/views/layouts"
)

templ DashboardPage(user *models.User, servers []models.Server) {
	@layouts.Base("Dashboard", user) {
		<div class="flex h-screen">
			@components.Sidebar(user)
			<main class="flex-1 p-8 overflow-auto">
				<div class="flex justify-between items-center mb-8">
					<h1 class="text-3xl font-bold">Game Servers</h1>
					if user.IsAdmin {
						<a href="/servers/new" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded transition">
							+ New Server
						</a>
					}
				</div>
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="server-list">
					if len(servers) == 0 {
						<div class="col-span-full text-center py-12 text-gray-400">
							<p class="text-xl mb-4">No servers yet</p>
							if user.IsAdmin {
								<a href="/servers/new" class="text-blue-400 hover:underline">Create your first server</a>
							}
						</div>
					} else {
						for _, server := range servers {
							// Server cards will be rendered by HTMX or we'll create ServerCard component
							<div class="bg-gray-800 rounded-lg p-6 border border-gray-700 hover:border-gray-600 transition cursor-pointer" hx-get={ "/servers/" + server.ID } hx-push-url="true">
								<div class="flex justify-between items-start mb-4">
									<h3 class="text-lg font-semibold">{ server.Name }</h3>
									<span class={ "px-2 py-1 rounded text-xs font-medium", templ.KV("bg-green-500/20 text-green-300", server.Status == "running"), templ.KV("bg-red-500/20 text-red-300", server.Status == "stopped"), templ.KV("bg-yellow-500/20 text-yellow-300", server.Status == "starting") }>
										{ string(server.Status) }
									</span>
								</div>
								<p class="text-gray-400 text-sm mb-2">{ server.GameType }</p>
								<p class="text-gray-500 text-xs">Port: { strconv.Itoa(server.Port) }</p>
							</div>
						}
					}
				</div>
			</main>
		</div>
	}
}
