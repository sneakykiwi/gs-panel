package servers

import (
	"fmt"
	"github.com/sneakykiwi/gs-panel/internal/models"
	"github.com/sneakykiwi/gs-panel/views/components"
	"github.com/sneakykiwi/gs-panel/views/layouts"
)

templ SchedulesPage(user *models.User, server *models.Server, schedules []models.BackupSchedule) {
	@layouts.Base("Backup Schedules", user) {
		<div class="flex h-screen">
			@components.Sidebar(user)

			<main class="flex-1 p-8 overflow-auto">
				<div class="mb-6">
					<a href={ templ.SafeURL("/servers/" + server.ID) } class="text-gray-400 hover:text-white text-sm">&larr; Back to Server</a>
				</div>

				<div class="flex justify-between items-center mb-8">
					<div>
						<h1 class="text-2xl font-bold">Backup Schedules</h1>
						<p class="text-gray-400">{ server.Name }</p>
					</div>
					<button onclick="document.getElementById('schedule-modal').classList.remove('hidden')"
						class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded transition">
						+ New Schedule
					</button>
				</div>

				<div class="bg-gray-800 rounded-lg border border-gray-700">
					if len(schedules) > 0 {
						<table class="w-full">
							<thead>
								<tr class="border-b border-gray-700">
									<th class="text-left p-4 font-medium text-gray-400">Name</th>
									<th class="text-left p-4 font-medium text-gray-400">Schedule</th>
									<th class="text-left p-4 font-medium text-gray-400">Retention</th>
									<th class="text-left p-4 font-medium text-gray-400">Status</th>
									<th class="text-right p-4 font-medium text-gray-400">Actions</th>
								</tr>
							</thead>
							<tbody>
								for _, schedule := range schedules {
									@ScheduleRow(&schedule)
								}
							</tbody>
						</table>
					} else {
						<div class="p-8 text-center text-gray-400">
							<p>No scheduled backups configured</p>
						</div>
					}
				</div>

				<div class="mt-8 bg-gray-800 rounded-lg p-6 border border-gray-700">
					<h2 class="text-lg font-bold mb-4">Cron Expression Examples</h2>
					<div class="grid grid-cols-2 gap-4 text-sm">
						<div>
							<code class="text-blue-400">0 0 * * *</code>
							<span class="text-gray-400 ml-2">Daily at midnight</span>
						</div>
						<div>
							<code class="text-blue-400">0 */6 * * *</code>
							<span class="text-gray-400 ml-2">Every 6 hours</span>
						</div>
						<div>
							<code class="text-blue-400">0 0 * * 0</code>
							<span class="text-gray-400 ml-2">Weekly on Sunday</span>
						</div>
						<div>
							<code class="text-blue-400">0 0 1 * *</code>
							<span class="text-gray-400 ml-2">Monthly on the 1st</span>
						</div>
					</div>
				</div>
			</main>
		</div>

		@ScheduleModal(server.ID)
	}
}

templ ScheduleRow(schedule *models.BackupSchedule) {
	<tr class="border-b border-gray-700 last:border-0" id={ "schedule-" + schedule.ID }>
		<td class="p-4">{ schedule.Name }</td>
		<td class="p-4 font-mono text-sm text-gray-400">{ schedule.CronExpr }</td>
		<td class="p-4 text-gray-400">
			{ formatRetention(schedule.KeepCount, schedule.KeepDays) }
		</td>
		<td class="p-4">
			if schedule.Enabled {
				<span class="px-2 py-1 bg-green-500/20 text-green-400 rounded text-xs">Active</span>
			} else {
				<span class="px-2 py-1 bg-gray-500/20 text-gray-400 rounded text-xs">Disabled</span>
			}
		</td>
		<td class="p-4 text-right">
			if schedule.Enabled {
				<button hx-post={ "/schedules/" + schedule.ID + "/toggle" } hx-vals='{"enabled": "false"}' hx-swap="none"
					hx-on::after-request="location.reload()"
					class="text-yellow-400 hover:text-yellow-300 mr-4">Disable</button>
			} else {
				<button hx-post={ "/schedules/" + schedule.ID + "/toggle" } hx-vals='{"enabled": "true"}' hx-swap="none"
					hx-on::after-request="location.reload()"
					class="text-green-400 hover:text-green-300 mr-4">Enable</button>
			}
			<button hx-delete={ "/schedules/" + schedule.ID }
				hx-confirm="Delete this schedule?"
				hx-target={ "#schedule-" + schedule.ID }
				hx-swap="outerHTML"
				class="text-red-400 hover:text-red-300">Delete</button>
		</td>
	</tr>
}

templ ScheduleModal(serverID string) {
	<div id="schedule-modal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
		<div class="bg-gray-800 rounded-lg p-6 w-full max-w-md">
			<h2 class="text-xl font-bold mb-4">Create Backup Schedule</h2>
			<form method="POST" action={ templ.SafeURL("/servers/" + serverID + "/schedules") }>
				@components.CsrfToken()
				<div class="mb-4">
					<label class="block text-sm font-medium mb-2">Name</label>
					<input type="text" name="name" required
						class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded focus:outline-none focus:border-blue-500"
						placeholder="Daily Backup"/>
				</div>
				<div class="mb-4">
					<label class="block text-sm font-medium mb-2">Cron Expression</label>
					<input type="text" name="cron_expr" required
						class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded focus:outline-none focus:border-blue-500 font-mono"
						placeholder="0 0 * * *"/>
				</div>
				<div class="grid grid-cols-2 gap-4 mb-4">
					<div>
						<label class="block text-sm font-medium mb-2">Keep Backups (count)</label>
						<input type="number" name="keep_count" min="0"
							class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded focus:outline-none focus:border-blue-500"
							placeholder="5"/>
					</div>
					<div>
						<label class="block text-sm font-medium mb-2">Keep Days</label>
						<input type="number" name="keep_days" min="0"
							class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded focus:outline-none focus:border-blue-500"
							placeholder="7"/>
					</div>
				</div>
				<div class="flex gap-4">
					<button type="submit" class="flex-1 bg-green-600 hover:bg-green-700 text-white py-2 rounded transition">
						Create
					</button>
					<button type="button" onclick="document.getElementById('schedule-modal').classList.add('hidden')"
						class="flex-1 bg-gray-600 hover:bg-gray-700 text-white py-2 rounded transition">
						Cancel
					</button>
				</div>
			</form>
		</div>
	</div>
}

func formatRetention(keepCount, keepDays int) string {
	var result string
	if keepCount > 0 {
		result = fmt.Sprintf("Keep %d backups", keepCount)
	}
	if keepCount > 0 && keepDays > 0 {
		result += ", "
	}
	if keepDays > 0 {
		result += fmt.Sprintf("%d days", keepDays)
	}
	return result
}
