package servers

import (
	"fmt"
	"github.com/sneakykiwi/gs-panel/internal/models"
	"github.com/sneakykiwi/gs-panel/internal/services"
	"github.com/sneakykiwi/gs-panel/views/components"
	"github.com/sneakykiwi/gs-panel/views/layouts"
)

templ CreateAdvancedPage(user *models.User, template services.GameTemplate, yamlContent string, errorMsg string) {
	@layouts.Base("Create Server (Advanced)", user) {
		<div class="flex h-screen">
			@components.Sidebar(user)

			<main class="flex-1 p-8 overflow-auto">
				<div class="mb-6">
					<a href="/servers/new" class="text-gray-400 hover:text-white text-sm">
						← Back to Simple Mode
					</a>
				</div>

				<div class="flex items-center gap-3 mb-6">
					<div class="bg-yellow-500/20 p-2 rounded">
						<svg class="w-5 h-5 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
						</svg>
					</div>
					<div>
						<h1 class="text-2xl font-bold">Create Server (Advanced)</h1>
						<p class="text-gray-400 text-sm">Customizing template: { template.Name }</p>
					</div>
				</div>

				if errorMsg != "" {
					<div class="bg-red-500/20 border border-red-500 text-red-300 px-4 py-3 rounded mb-6">
						{ errorMsg }
					</div>
				}

				<div class="bg-blue-500/20 border border-blue-500 text-blue-300 px-4 py-3 rounded mb-6">
					<div class="flex items-start gap-3">
						<svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
						<div>
							<p class="font-medium mb-1">Security Policy</p>
							<p class="text-sm text-blue-200">Custom templates are subject to security validation. Volume mounts must be within allowed directories, and only approved container capabilities are permitted.</p>
						</div>
					</div>
				</div>

				<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
					<div class="lg:col-span-2">
						<form id="advanced-form" method="POST" action="/servers/new/advanced" class="bg-gray-800 rounded-lg p-6 border border-gray-700">
							<input type="hidden" name="source_template" value={ template.ID }/>

							<div class="grid grid-cols-2 gap-4 mb-6">
								<div>
									<label class="block text-sm font-medium mb-2" for="server_name">Server Name</label>
									<input type="text" id="server_name" name="server_name" required
										class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded focus:outline-none focus:border-blue-500"
										placeholder="My Custom Server"/>
								</div>
								<div>
									<label class="block text-sm font-medium mb-2" for="docker_image">Docker Image</label>
									<input type="text" id="docker_image" name="docker_image" required
										class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded focus:outline-none focus:border-blue-500"
										value={ template.DockerImage }
										placeholder="e.g. itzg/minecraft-server:latest"/>
									<p class="text-gray-500 text-xs mt-1">Docker image to use for the server</p>
								</div>
							</div>

							<div class="grid grid-cols-2 gap-4 mb-6">
								<div>
									<label class="block text-sm font-medium mb-2" for="memory_limit">Memory Limit (MB)</label>
									<input type="number" id="memory_limit" name="memory_limit" min="512" step="256"
										class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded focus:outline-none focus:border-blue-500"
										value={ fmt.Sprintf("%d", template.DefaultMemory) }/>
								</div>
								<div>
									<label class="block text-sm font-medium mb-2" for="port">Port</label>
									<input type="number" id="port" name="port" min="1024" max="65535"
										class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded focus:outline-none focus:border-blue-500"
										value={ fmt.Sprintf("%d", template.DefaultPort) }/>
								</div>
							</div>

							<div class="mb-6">
								<label class="block text-sm font-medium mb-2">Template YAML</label>
								<textarea
									id="yaml-editor"
									name="yaml_content"
									rows="25"
									class="w-full px-4 py-3 bg-gray-900 border border-gray-700 rounded font-mono text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 resize-y"
									spellcheck="false"
								>{ yamlContent }</textarea>
							</div>

							<div class="bg-gray-700/50 rounded p-4 mb-6">
								<label class="flex items-center gap-3 cursor-pointer">
									<input type="checkbox" name="save_template" value="true" checked
										class="w-4 h-4 rounded border-gray-600 bg-gray-700 text-blue-500 focus:ring-blue-500"/>
									<div>
										<span class="font-medium">Save as reusable template</span>
										<p class="text-sm text-gray-400">Keep this custom template for future servers</p>
									</div>
								</label>
							</div>

							<div class="flex gap-4">
								<button type="submit"
									class="flex-1 bg-green-600 hover:bg-green-700 text-white font-medium py-2 px-4 rounded transition">
									Create Server with Custom Template
								</button>
								<a href="/servers/new"
									class="bg-gray-600 hover:bg-gray-700 text-white font-medium py-2 px-4 rounded transition text-center">
									Cancel
								</a>
							</div>
						</form>

						<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.12/codemirror.min.css"/>
						<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.12/theme/dracula.min.css"/>
						<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.12/codemirror.min.js"></script>
						<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.12/mode/yaml/yaml.min.js"></script>
						@advancedEditorScript()
					</div>

					<div class="space-y-4">
						<div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
							<h3 class="font-medium mb-3 flex items-center gap-2">
								<svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
								</svg>
								Template Variables
							</h3>
							<p class="text-gray-400 text-xs mb-4">Use in environment values. Replaced when server starts.</p>

							<div class="space-y-2 text-sm">
								@VariableItem("{{MEMORY}}", "Memory limit in MB")
								@VariableItem("{{PORT}}", "Server port")
								@VariableItem("{{SERVER_ID}}", "Server UUID")
								@VariableItem("{{SERVER_NAME}}", "Server name")
							</div>
						</div>

						<div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
							<h3 class="font-medium mb-3 flex items-center gap-2">
								<svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
								</svg>
								Required Fields
							</h3>
							<ul class="text-sm text-gray-400 space-y-1">
								<li><code class="bg-gray-700 px-1 rounded text-xs">id</code> - Template ID</li>
								<li><code class="bg-gray-700 px-1 rounded text-xs">name</code> - Display name</li>
								<li><code class="bg-gray-700 px-1 rounded text-xs">docker_image</code> - Docker image</li>
							</ul>
						</div>

						<div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
							<h3 class="font-medium mb-3 flex items-center gap-2">
								<svg class="w-4 h-4 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
								</svg>
								Quick Reference
							</h3>
							<ul class="text-sm text-gray-400 space-y-1">
								<li><a href="/templates/README.md" target="_blank" class="text-blue-400 hover:underline">Template Documentation →</a></li>
							</ul>
						</div>
					</div>
				</div>
			</main>
		</div>
	}
}

templ VariableItem(variable string, description string) {
	<div class="flex items-center justify-between bg-gray-900 rounded px-3 py-2">
		<code class="text-yellow-300 text-xs">{ variable }</code>
		<span class="text-gray-500 text-xs">{ description }</span>
	</div>
}

script advancedEditorScript() {
	var advEditor = CodeMirror.fromTextArea(document.getElementById("yaml-editor"), {
		lineNumbers: true,
		mode: "yaml",
		theme: "dracula",
		tabSize: 2,
		indentWithTabs: false,
		extraKeys: {"Tab": "indentMore", "Shift-Tab": "indentLess"},
		viewportMargin: Infinity
	});
	advEditor.setSize("100%", null);

	var dockerImageInput = document.getElementById("docker_image");
	var serverNameInput = document.getElementById("server_name");
	var updatingFromInput = false;
	var updatingFromEditor = false;

	function updateYamlField(fieldName, newValue) {
		var content = advEditor.getValue();
		var regex = new RegExp("^(" + fieldName + ":\\s*)(.*)$", "m");
		if (regex.test(content)) {
			content = content.replace(regex, "$1" + newValue);
		} else {
			var lines = content.split("\n");
			lines.splice(1, 0, fieldName + ": " + newValue);
			content = lines.join("\n");
		}
		advEditor.setValue(content);
	}

	function getYamlField(fieldName) {
		var content = advEditor.getValue();
		var regex = new RegExp("^" + fieldName + ":\\s*(.*)$", "m");
		var match = content.match(regex);
		return match ? match[1].trim().replace(/^["']|["']$/g, '') : null;
	}

	dockerImageInput.addEventListener("input", function() {
		if (updatingFromEditor) return;
		updatingFromInput = true;
		updateYamlField("docker_image", dockerImageInput.value);
		updatingFromInput = false;
	});

	serverNameInput.addEventListener("input", function() {
		if (updatingFromEditor) return;
		updatingFromInput = true;
		updateYamlField("name", '"' + serverNameInput.value + '"');
		updatingFromInput = false;
	});

	advEditor.on("change", function() {
		if (updatingFromInput) return;
		updatingFromEditor = true;
		var dockerImage = getYamlField("docker_image");
		if (dockerImage !== null) {
			dockerImageInput.value = dockerImage;
		}
		var name = getYamlField("name");
		if (name !== null) {
			serverNameInput.value = name;
		}
		updatingFromEditor = false;
	});

	document.getElementById("advanced-form").onsubmit = function() {
		advEditor.save();
	};
}

