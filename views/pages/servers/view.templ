package servers

import (
	"github.com/sneakykiwi/gs-panel/internal/models"
	"github.com/sneakykiwi/gs-panel/views/layouts"
	"github.com/sneakykiwi/gs-panel/views/components"
	"github.com/sneakykiwi/gs-panel/views/partials"
	"strconv"
)

templ ViewPage(server *models.Server, user *models.User, isOutdated bool, newVersion string) {
	@layouts.Base(server.Name, user) {
		<div class="flex h-screen">
			@components.Sidebar(user)
			
			<main class="flex-1 p-8 overflow-auto">
				<div class="mb-6">
					<a href="/" class="text-gray-400 hover:text-white text-sm">← Back to Dashboard</a>
				</div>

				if isOutdated && user.IsAdmin {
					<div class="mb-6 bg-blue-500/20 border border-blue-500 rounded-lg p-4 flex items-center justify-between">
						<div>
							<p class="font-medium text-blue-300">Template Update Available</p>
							<p class="text-sm text-blue-200/70">
								Current: { server.TemplateVersion } → New: { newVersion }
							</p>
						</div>
						<form method="POST" action={ templ.URL("/servers/" + server.ID + "/upgrade") }>
							@components.CsrfToken()
							<button
								type="submit"
								class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded text-sm transition"
							>
								Upgrade Template
							</button>
						</form>
					</div>
				}

				<div class="flex justify-between items-start mb-8">
					<div>
						<h1 class="text-3xl font-bold">{ server.Name }</h1>
						<p class="text-gray-400">{ server.GameType }</p>
					</div>
					
					<div 
						hx-get={ "/servers/" + server.ID + "/status-badge" }
						hx-trigger="load, every 3s"
						hx-swap="outerHTML"
					>
						@partials.ServerStatusBadge(server.Status)
					</div>
				</div>
				
				<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
					<div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
						<h3 class="text-sm font-medium text-gray-400 mb-2">Port</h3>
						<p class="text-2xl font-bold">{ strconv.Itoa(server.Port) }</p>
					</div>
					<div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
						<h3 class="text-sm font-medium text-gray-400 mb-2">Memory Limit</h3>
						<p class="text-2xl font-bold">{ strconv.Itoa(server.MemoryLimit) } MB</p>
					</div>
					<div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
						<h3 class="text-sm font-medium text-gray-400 mb-2">Docker Image</h3>
						<p class="text-sm font-mono truncate" title={ server.DockerImage }>
							{ server.DockerImage }
						</p>
					</div>
				</div>
				
			<div class="bg-gray-800 rounded-lg p-6 border border-gray-700 mb-8" x-data="{ loading: false, action: '' }">
				<h2 class="text-xl font-bold mb-4">Controls</h2>
				@partials.ServerControls(server, user.IsAdmin)
			</div>

			<div id="image-pull-progress" class="hidden bg-gray-800 rounded-lg p-6 border border-gray-700 mb-8">
				<h3 class="text-lg font-semibold mb-4 text-blue-400">Pulling Docker Image</h3>
				<div class="space-y-3">
					<div class="flex justify-between text-sm">
						<span id="pull-status" class="text-gray-300">Starting pull...</span>
						<span id="pull-percentage" class="font-mono font-bold">0%</span>
					</div>
					<div class="w-full bg-gray-700 rounded-full h-4 overflow-hidden">
						<div id="pull-bar" class="bg-blue-600 h-full rounded-full transition-all duration-300" style="width: 0%"></div>
					</div>
					<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 text-sm">
						<div class="bg-gray-900 rounded p-3">
							<div class="text-gray-400 text-xs mb-1">Downloaded</div>
							<div id="pull-downloaded" class="font-mono text-xs">0 MB</div>
						</div>
						<div class="bg-gray-900 rounded p-3">
							<div class="text-gray-400 text-xs mb-1">Total Size</div>
							<div id="pull-total" class="font-mono text-xs">0 MB</div>
						</div>
						<div class="bg-gray-900 rounded p-3">
							<div class="text-gray-400 text-xs mb-1">Speed</div>
							<div id="pull-speed" class="font-mono text-xs">0 MB/s</div>
						</div>
						<div class="bg-gray-900 rounded p-3">
							<div class="text-gray-400 text-xs mb-1">ETA</div>
							<div id="pull-eta" class="font-mono text-xs">—</div>
						</div>
					</div>
					<div class="flex justify-between text-xs text-gray-400">
						<span id="pull-layers">Layer 0/0</span>
						<span id="pull-image" class="truncate max-w-[200px]" title="">—</span>
					</div>
				</div>
			</div>

				<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
					<!-- CONSOLE -->
					<div class="bg-gray-800 rounded-lg p-6 border border-gray-700" x-data="{ fullscreen: false }">
						<div class="flex justify-between items-center mb-4">
							<h2 class="text-xl font-bold">Console</h2>
							<button @click="fullscreen = !fullscreen" class="text-gray-400 hover:text-white transition p-1" title="Toggle Fullscreen">
								<svg x-show="!fullscreen" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/>
								</svg>
								<svg x-show="fullscreen" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
								</svg>
							</button>
						</div>
						
						<div 
							id="console-out"
							class="bg-gray-900 rounded p-4 h-64 overflow-auto font-mono text-sm text-gray-300 whitespace-pre-wrap"
						></div>
						
						<form id="console-form" class="mt-4 flex gap-2">
							<input 
								type="text"
								id="console-input"
								name="command"
								placeholder="Enter command..."
								class="flex-1 px-3 py-2 bg-gray-700 border border-gray-600 rounded"
							/>
							<button 
								type="submit"
								class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded"
							>
								Send
							</button>
						</form>

						<div x-show="fullscreen" x-cloak class="fixed inset-0 z-50 bg-gray-900 p-6 flex flex-col">
							<div class="flex justify-between items-center mb-4">
								<h2 class="text-xl font-bold">Console (Full Screen)</h2>
								<button @click="fullscreen = false" class="text-gray-400 hover:text-white transition p-1" title="Close Fullscreen">
									<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
									</svg>
								</button>
							</div>
							<div id="console-out-fullscreen" class="flex-1 bg-gray-900 rounded p-4 overflow-auto font-mono text-sm text-gray-300 whitespace-pre-wrap"></div>
							<form id="console-form-fullscreen" class="mt-4 flex gap-2">
								<input 
									type="text"
									id="console-input-fullscreen"
									name="command"
									placeholder="Enter command..."
									class="flex-1 px-3 py-2 bg-gray-700 border border-gray-600 rounded"
								/>
								<button 
									type="submit"
									class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded"
								>
									Send
								</button>
							</form>
						</div>
					</div>

					<!-- STATS -->
					<div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
						<h2 class="text-xl font-bold mb-4">Stats</h2>
						
						<div class="grid grid-cols-2 gap-4 text-sm text-gray-300">
							<div class="bg-gray-900 rounded p-4">
								<div class="text-gray-400">CPU</div>
								<div id="cpu-value" class="text-xl font-bold">—</div>
							</div>
							<div class="bg-gray-900 rounded p-4">
								<div class="text-gray-400">Memory</div>
								<div id="mem-value" class="text-xl font-bold">—</div>
							</div>
							<div class="bg-gray-900 rounded p-4">
								<div class="text-gray-400 flex items-center gap-1">
									Net RX
									<span class="text-gray-500 cursor-help" title="Network data received by the container">ⓘ</span>
								</div>
								<div id="rx-value" class="text-xl font-bold">—</div>
							</div>
							<div class="bg-gray-900 rounded p-4">
								<div class="text-gray-400 flex items-center gap-1">
									Net TX
									<span class="text-gray-500 cursor-help" title="Network data sent by the container">ⓘ</span>
								</div>
								<div id="tx-value" class="text-xl font-bold">—</div>
							</div>
						</div>
					</div>
				</div>
				
				<!-- BACKUPS SECTION -->
				<div 
					hx-get={ "/servers/" + server.ID + "/backups" }
					hx-trigger="load, backup-created from:body"
					hx-swap="innerHTML"
				>
					@components.BackupSkeleton()
				</div>
				
				@WebSocketScript(server.ID)
			</main>
		</div>
	}
}

templ StatusBadge(status models.ServerStatus) {
	<span class={ "px-3 py-1 rounded text-sm font-medium " + statusClass(status) }>
		{ string(status) }
	</span>
}

script webSocketScriptContent(serverID string) {
	(function() {
		const scheme = location.protocol === 'https:' ? 'wss:' : 'ws:';
		const wsUrl = `${scheme}//${location.host}/servers/${serverID}/ws?interval=1000`;

			let ws = null;
			const consoleOut = document.getElementById('console-out');
			const consoleForm = document.getElementById('console-form');
			const consoleInput = document.getElementById('console-input');
			const consoleOutFullscreen = document.getElementById('console-out-fullscreen');
			const consoleInputFullscreen = document.getElementById('console-input-fullscreen');
			const pullProgress = document.getElementById('image-pull-progress');
			
			function formatBytes(bytes) {
				if (bytes === 0) return '0 MB';
				const mb = bytes / (1024 * 1024);
				return mb.toFixed(2) + ' MB';
			}

			function formatBytesDynamic(bytes) {
				if (bytes === 0) return '0 KB';
				if (bytes < 1024 * 1024) {
					return Math.round(bytes / 1024) + ' KB';
				}
				return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
			}

			function formatTime(seconds) {
				if (seconds < 60) return Math.round(seconds) + 's';
				if (seconds < 3600) return Math.floor(seconds / 60) + 'm ' + Math.round(seconds % 60) + 's';
				return Math.floor(seconds / 3600) + 'h ' + Math.floor((seconds % 3600) / 60) + 'm';
			}

			function updatePullProgress(data) {
				pullProgress.classList.remove('hidden');
				
				document.getElementById('pull-percentage').textContent = data.percentage.toFixed(1) + '%';
				document.getElementById('pull-bar').style.width = data.percentage + '%';
				document.getElementById('pull-downloaded').textContent = formatBytes(data.downloaded_bytes);
				document.getElementById('pull-total').textContent = formatBytes(data.total_bytes);
				document.getElementById('pull-speed').textContent = data.speed_mbps.toFixed(2) + ' MB/s';
				
				if (data.eta_seconds > 0 && data.eta_seconds < 86400) {
					document.getElementById('pull-eta').textContent = formatTime(data.eta_seconds);
				} else {
					document.getElementById('pull-eta').textContent = '—';
				}
				
				document.getElementById('pull-layers').textContent = 'Layer ' + data.completed_layers + '/' + data.total_layers;
				document.getElementById('pull-image').textContent = data.image || '';
				document.getElementById('pull-image').title = data.image || '';

				if (data.status === 'pulling') {
					document.getElementById('pull-status').textContent = 'Pulling image...';
				} else if (data.status === 'completed') {
					document.getElementById('pull-status').textContent = 'Pull completed!';
					document.getElementById('pull-status').classList.add('text-green-400');
					setTimeout(() => {
						pullProgress.classList.add('hidden');
						document.getElementById('pull-status').classList.remove('text-green-400');
					}, 3000);
				} else if (data.status === 'error') {
					document.getElementById('pull-status').textContent = 'Error: ' + data.error;
					document.getElementById('pull-status').classList.add('text-red-400');
				}
			}
			
			function connect() {
				ws = new WebSocket(wsUrl);
			ws.onmessage = function(ev) {
				try {
					const msg = JSON.parse(ev.data);
					if (msg.type === 'log') {
						const logLine = msg.data;
						if (logLine.startsWith('[json]')) {
							try {
								const jsonMsg = JSON.parse(logLine.substring(6));
								if (jsonMsg.type === 'image_pull') {
									updatePullProgress(jsonMsg.data);
								}
							} catch (e) {}
						} else {
							consoleOut.appendChild(document.createTextNode(logLine));
							consoleOut.scrollTop = consoleOut.scrollHeight;
							if (consoleOutFullscreen) {
								consoleOutFullscreen.appendChild(document.createTextNode(logLine));
								consoleOutFullscreen.scrollTop = consoleOutFullscreen.scrollHeight;
							}
						}
					} else if (msg.type === 'stats' && msg.data) {
						document.getElementById('cpu-value').textContent = msg.data.cpu || '—';
						document.getElementById('mem-value').textContent = msg.data.mem || '—';
						document.getElementById('rx-value').textContent = msg.data.rx ? formatBytesDynamic(msg.data.rx) : '—';
						document.getElementById('tx-value').textContent = msg.data.tx ? formatBytesDynamic(msg.data.tx) : '—';
					}
				} catch (_) {}
			};
			ws.onclose = function() {
				ws = null;
				setTimeout(connect, 3000);
			};
		}
		
		connect();

		consoleForm.addEventListener('submit', function(e) {
			e.preventDefault();
			const cmd = (consoleInput.value || '').trim();
			if (!cmd || !ws || ws.readyState !== WebSocket.OPEN) return;
			ws.send(JSON.stringify({ type: 'command', data: cmd }));
			consoleInput.value = '';
		});

		const consoleFormFullscreen = document.getElementById('console-form-fullscreen');
		if (consoleFormFullscreen) {
			consoleFormFullscreen.addEventListener('submit', function(e) {
				e.preventDefault();
				const cmd = (consoleInputFullscreen.value || '').trim();
				if (!cmd || !ws || ws.readyState !== WebSocket.OPEN) return;
				ws.send(JSON.stringify({ type: 'command', data: cmd }));
				consoleInputFullscreen.value = '';
			});
		}
	})();
}

templ WebSocketScript(serverID string) {
	@webSocketScriptContent(serverID)
}

func statusClass(status models.ServerStatus) string {
	switch status {
	case models.ServerStatusRunning:
		return "bg-green-500/20 text-green-400"
	case models.ServerStatusStarting:
		return "bg-yellow-500/20 text-yellow-400"
	default:
		return "bg-gray-500/20 text-gray-400"
	}
}
