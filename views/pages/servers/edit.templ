package servers

import (
	"github.com/sneakykiwi/gs-panel/internal/models"
	"github.com/sneakykiwi/gs-panel/views/layouts"
	"github.com/sneakykiwi/gs-panel/views/components"
	"strconv"
)

templ EditPage(server *models.Server, user *models.User, errors map[string]string, templateEnv map[string]string, customEnv map[string]string, varDescriptions map[string]string) {
	@layouts.Base("Edit Server - " + server.Name, user) {
		<div class="flex h-screen">
			@components.Sidebar(user)
			
			<main class="flex-1 p-8 overflow-auto">
				<div class="mb-6">
					<a href={ templ.URL("/servers/" + server.ID) } class="text-gray-400 hover:text-white text-sm">
						← Back to Server
					</a>
				</div>
				
				<h1 class="text-3xl font-bold mb-8">Edit Server</h1>
				
				@EditForm(server, errors, templateEnv, customEnv, varDescriptions)
			</main>
		</div>
	}
}

templ EditForm(server *models.Server, errors map[string]string, templateEnv map[string]string, customEnv map[string]string, varDescriptions map[string]string) {
	<div class="max-w-2xl" id="edit-form-container">
		<form 
			hx-put={ "/servers/" + server.ID }
			hx-target="#edit-form-container"
			hx-swap="outerHTML"
			class="bg-gray-800 rounded-lg p-6 border border-gray-700"
		>
			if errors != nil && errors["_general"] != "" {
				<div class="mb-6 bg-red-500/20 border border-red-500 text-red-300 px-4 py-3 rounded">
					{ errors["_general"] }
				</div>
			}
			
			<div class="mb-6">
				<label for="name" class="block text-sm font-medium mb-2">
					Server Name
				</label>
				<input 
					type="text"
					id="name"
					name="name"
					value={ server.Name }
					class={ "w-full px-4 py-2 bg-gray-700 border rounded focus:outline-none focus:ring-2 " + 
						   inputBorderClass(errors, "name") }
					required
					minlength="3"
					maxlength="50"
				/>
				if errors != nil && errors["name"] != "" {
					<p class="text-red-400 text-sm mt-1">{ errors["name"] }</p>
				}
			</div>
			
			<div class="mb-6">
				<label for="memory_limit" class="block text-sm font-medium mb-2">
					Memory Limit (MB)
				</label>
				<input 
					type="number"
					id="memory_limit"
					name="memory_limit"
					value={ strconv.Itoa(server.MemoryLimit) }
					class={ "w-full px-4 py-2 bg-gray-700 border rounded focus:outline-none focus:ring-2 " + 
						   inputBorderClass(errors, "memory_limit") }
					min="512"
					max="16384"
					required
				/>
				if errors != nil && errors["memory_limit"] != "" {
					<p class="text-red-400 text-sm mt-1">{ errors["memory_limit"] }</p>
				}
				<p class="text-gray-400 text-sm mt-1">Recommended: 2048 MB for most game servers</p>
			</div>
			
			<div class="mb-6">
				<label for="port" class="block text-sm font-medium mb-2">
					Server Port
				</label>
				<input 
					type="number"
					id="port"
					name="port"
					value={ strconv.Itoa(server.Port) }
					class={ "w-full px-4 py-2 bg-gray-700 border rounded focus:outline-none focus:ring-2 " + 
						   inputBorderClass(errors, "port") }
					min="1024"
					max="65535"
					required
				/>
				if errors != nil && errors["port"] != "" {
					<p class="text-red-400 text-sm mt-1">{ errors["port"] }</p>
				}
			</div>
			
			if len(templateEnv) > 0 {
				<div class="mb-6" x-data="{ open: false }">
					<button
						type="button"
						@click="open = !open"
						class="flex items-center justify-between w-full px-4 py-3 bg-gray-700 rounded border border-gray-600 hover:border-gray-500 transition"
					>
						<span class="font-medium">Advanced Settings</span>
						<svg
							class="w-5 h-5 transition-transform"
							:class="{ 'rotate-180': open }"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
						>
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
						</svg>
					</button>

					<div x-show="open" x-cloak class="mt-4 space-y-4 border-l-2 border-gray-600 pl-4">
						<p class="text-sm text-gray-400">
							Override template environment variables. Leave empty to use defaults.
						</p>
						for key, defaultVal := range templateEnv {
							<div>
								<label class="block text-sm font-medium mb-1">
									{ key }
									if varDescriptions != nil && varDescriptions[key] != "" {
										<span class="text-gray-500 font-normal ml-2" title={ varDescriptions[key] }>ⓘ</span>
									}
								</label>
								<input
									type="text"
									name={ "env_" + key }
									value={ getEnvValue(customEnv, key) }
									placeholder={ defaultVal }
									class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
								/>
								if varDescriptions != nil && varDescriptions[key] != "" {
									<p class="text-gray-500 text-xs mt-1">{ varDescriptions[key] }</p>
								}
							</div>
						}
					</div>
				</div>
			}

			if server.Status == models.ServerStatusRunning {
				<div class="mb-6 bg-yellow-500/20 border border-yellow-500 text-yellow-300 px-4 py-3 rounded">
					<p class="font-medium">⚠️ Server is Running</p>
					<p class="text-sm">The server will be automatically restarted with the new configuration.</p>
				</div>
			}
			
			<div class="flex gap-3">
				<button 
					type="submit"
					class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded transition"
				>
					Save Changes
				</button>
				
				<a 
					href={ templ.URL("/servers/" + server.ID) }
					class="bg-gray-600 hover:bg-gray-700 text-white px-6 py-2 rounded transition inline-block"
				>
					Cancel
				</a>
			</div>
		</form>
	</div>
}

func getEnvValue(customEnv map[string]string, key string) string {
	if customEnv == nil {
		return ""
	}
	return customEnv[key]
}

func inputBorderClass(errors map[string]string, field string) string {
	if errors != nil && errors[field] != "" {
		return "border-red-500 focus:ring-red-500"
	}
	return "border-gray-600 focus:ring-blue-500"
}
