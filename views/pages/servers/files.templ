package servers

import (
	"fmt"

	"github.com/a-h/templ"
	"github.com/sneakykiwi/gs-panel/internal/models"
	"github.com/sneakykiwi/gs-panel/views/components"
	"github.com/sneakykiwi/gs-panel/views/layouts"
)

templ FilesPage(user *models.User, server *models.Server, files []models.FileInfo, path string, parentPath string) {
	@layouts.Base("Files - " + server.Name, user) {
		<div class="flex h-screen">
			@components.Sidebar(user)
			<main class="flex-1 p-8 overflow-auto">
				<div class="mb-6">
					<a href={ templ.SafeURL("/servers/" + server.ID) } class="text-gray-400 hover:text-white text-sm">← Back to Server</a>
				</div>
				<div class="flex justify-between items-center mb-6">
					<div>
						<h1 class="text-2xl font-bold">{ server.Name } - Files</h1>
						<p class="text-gray-400 font-mono text-sm">{ path }</p>
					</div>
					<div class="flex gap-2">
						<button onclick="document.getElementById('upload-modal').classList.remove('hidden')"
							class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded transition">
							Upload File
						</button>
						<button onclick="document.getElementById('mkdir-modal').classList.remove('hidden')"
							class="bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded transition">
							New Folder
						</button>
					</div>
				</div>
				<div class="bg-gray-800 rounded-lg border border-gray-700">
					<table class="w-full">
						<thead>
							<tr class="border-b border-gray-700">
								<th class="text-left p-4 font-medium text-gray-400">Name</th>
								<th class="text-left p-4 font-medium text-gray-400">Size</th>
								<th class="text-left p-4 font-medium text-gray-400">Modified</th>
								<th class="text-right p-4 font-medium text-gray-400">Actions</th>
							</tr>
						</thead>
						<tbody>
							if parentPath != "" {
								<tr class="border-b border-gray-700">
									<td class="p-4" colspan="4">
										<a href={ templ.SafeURL("/servers/" + server.ID + "/files?path=" + parentPath) } class="text-blue-400 hover:text-blue-300">
											📁 ..
										</a>
									</td>
								</tr>
							}
							for _, file := range files {
								<tr class="border-b border-gray-700 last:border-0 hover:bg-gray-700/50">
									<td class="p-4">
										if file.IsDir {
											<a href={ templ.SafeURL("/servers/" + server.ID + "/files?path=" + file.Path) } class="text-blue-400 hover:text-blue-300">
												📁 { file.Name }
											</a>
										} else {
											<a href={ templ.SafeURL("/servers/" + server.ID + "/files/view?path=" + file.Path) } class="text-gray-100 hover:text-white">
												📄 { file.Name }
											</a>
										}
									</td>
									<td class="p-4 text-gray-400">
										if file.IsDir {
											—
										} else {
											{ formatFileSize(file.Size) }
										}
									</td>
<td class="p-4 text-gray-400">
											{ file.ModTime }
										</td>
									<td class="p-4 text-right">
										<button hx-delete={ "/servers/" + server.ID + "/files/delete?path=" + file.Path }
											hx-confirm="Delete this file?"
											hx-swap="none"
											hx-on::after-request="location.reload()"
											class="text-red-400 hover:text-red-300">
											Delete
										</button>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</main>
		</div>
	}
}

func formatFileSize(size int64) string {
	const unit = 1024
	if size < unit {
		return "{size} B"
	}
	div, exp := int64(unit), 0
	for n := size / unit; n >= unit; n /= unit {
		div *= unit
		exp++
	}
	return fmt.Sprintf("%.1f %cB", float64(size)/float64(div), "KMGTPE"[exp])
}
