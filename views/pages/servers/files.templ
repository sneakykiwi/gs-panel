package servers

import (
	"fmt"
	"github.com/sneakykiwi/gs-panel/internal/models"
	"github.com/sneakykiwi/gs-panel/views/components"
	"github.com/sneakykiwi/gs-panel/views/layouts"
)

templ FilesPage(user *models.User, server *models.Server, files []models.FileInfo, path string, parentPath string) {
	@layouts.Base(server.Name + " - Files", user) {
		<div class="flex h-screen">
			@components.Sidebar(user)

			<main class="flex-1 p-8 overflow-auto">
				<div class="mb-6">
					<a href={ templ.SafeURL("/servers/" + server.ID) } class="text-gray-400 hover:text-white text-sm">&larr; Back to Server</a>
				</div>

				<div class="flex justify-between items-center mb-6">
					<div>
						<h1 class="text-2xl font-bold">{ server.Name } - Files</h1>
						<p class="text-gray-400 font-mono text-sm">{ path }</p>
					</div>
					<div class="flex gap-2">
						<button onclick="document.getElementById('upload-modal').classList.remove('hidden')"
							class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded transition">
							Upload File
						</button>
						<button onclick="document.getElementById('mkdir-modal').classList.remove('hidden')"
							class="bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded transition">
							New Folder
						</button>
					</div>
				</div>

				<div class="bg-gray-800 rounded-lg border border-gray-700">
					<table class="w-full">
						<thead>
							<tr class="border-b border-gray-700">
								<th class="text-left p-4 font-medium text-gray-400">Name</th>
								<th class="text-left p-4 font-medium text-gray-400">Size</th>
								<th class="text-left p-4 font-medium text-gray-400">Modified</th>
								<th class="text-right p-4 font-medium text-gray-400">Actions</th>
							</tr>
						</thead>
						<tbody>
							if parentPath != "" {
								<tr class="border-b border-gray-700">
									<td class="p-4" colspan="4">
										<a href={ templ.SafeURL("/servers/" + server.ID + "/files?path=" + parentPath) } class="text-blue-400 hover:text-blue-300">
											📁 ..
										</a>
									</td>
								</tr>
							}
							if len(files) > 0 {
								for _, file := range files {
									@FileRow(server.ID, &file)
								}
							} else {
								<tr>
									<td class="p-8 text-center text-gray-400" colspan="4">This folder is empty</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</main>
		</div>

		@UploadModal(server.ID, path)
		@MkdirModal(server.ID, path)
		@RenameModal(server.ID)
	}
}

templ FileRow(serverID string, file *models.FileInfo) {
	<tr class="border-b border-gray-700 last:border-0 hover:bg-gray-700/50">
		<td class="p-4">
			if file.IsDir {
				<a href={ templ.SafeURL("/servers/" + serverID + "/files?path=" + file.Path) } class="text-blue-400 hover:text-blue-300">
					📁 { file.Name }
				</a>
			} else {
				<a href={ templ.SafeURL("/servers/" + serverID + "/files/view?path=" + file.Path) } class="text-gray-100 hover:text-white">
					📄 { file.Name }
				</a>
			}
		</td>
		<td class="p-4 text-gray-400">
			{ formatFileSize(file.Size, file.IsDir) }
		</td>
		<td class="p-4 text-gray-400">{ file.ModTime }</td>
		<td class="p-4 text-right space-x-2">
			if !file.IsDir {
				<a href={ templ.SafeURL("/servers/" + serverID + "/files/download?path=" + file.Path) }
					class="text-blue-400 hover:text-blue-300 text-sm">
					Download
				</a>
			}
			<button onclick={ showRenameModal(file.Path, file.Name) }
				class="text-green-400 hover:text-green-300 text-sm">
				Rename
			</button>
			<button hx-delete={ "/servers/" + serverID + "/files?path=" + file.Path }
				hx-confirm={ "Delete " + file.Name + "?" }
				hx-swap="none"
				hx-on::after-request="location.reload()"
				class="text-red-400 hover:text-red-300 text-sm">
				Delete
			</button>
		</td>
	</tr>
}

templ UploadModal(serverID string, path string) {
	<div id="upload-modal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
		<div class="bg-gray-800 rounded-lg p-6 w-full max-w-md">
			<h2 class="text-xl font-bold mb-4">Upload File</h2>
			<form method="POST" action={ templ.SafeURL("/servers/" + serverID + "/files/upload") } enctype="multipart/form-data">
				@components.CsrfToken()
				<input type="hidden" name="path" value={ path }/>
				<div class="mb-4">
					<input type="file" name="file" required
						class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded"/>
				</div>
				<div class="flex gap-4">
					<button type="submit" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white py-2 rounded transition">
						Upload
					</button>
					<button type="button" onclick="document.getElementById('upload-modal').classList.add('hidden')"
						class="flex-1 bg-gray-600 hover:bg-gray-700 text-white py-2 rounded transition">
						Cancel
					</button>
				</div>
			</form>
		</div>
	</div>
}

templ MkdirModal(serverID string, path string) {
	<div id="mkdir-modal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
		<div class="bg-gray-800 rounded-lg p-6 w-full max-w-md">
			<h2 class="text-xl font-bold mb-4">Create Folder</h2>
			<form method="POST" action={ templ.SafeURL("/servers/" + serverID + "/files/mkdir") }>
				@components.CsrfToken()
				<input type="hidden" name="path" value={ path }/>
				<div class="mb-4">
					<label class="block text-sm font-medium mb-2">Folder Name</label>
					<input type="text" name="name" required
						class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded focus:outline-none focus:border-blue-500"/>
				</div>
				<div class="flex gap-4">
					<button type="submit" class="flex-1 bg-green-600 hover:bg-green-700 text-white py-2 rounded transition">
						Create
					</button>
					<button type="button" onclick="document.getElementById('mkdir-modal').classList.add('hidden')"
						class="flex-1 bg-gray-600 hover:bg-gray-700 text-white py-2 rounded transition">
						Cancel
					</button>
				</div>
			</form>
		</div>
	</div>
}

templ RenameModal(serverID string) {
	<div id="rename-modal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
		<div class="bg-gray-800 rounded-lg p-6 w-full max-w-md">
			<h2 class="text-xl font-bold mb-4">Rename</h2>
			<form hx-post={ "/servers/" + serverID + "/files/rename" } hx-swap="none" hx-on::after-request="location.reload()">
				@components.CsrfToken()
				<input type="hidden" name="old_path" id="rename-old-path"/>
				<div class="mb-4">
					<label class="block text-sm font-medium mb-2">New Name</label>
					<input type="text" name="new_name" id="rename-new-name" required
						class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded focus:outline-none focus:border-blue-500"/>
				</div>
				<div class="flex gap-4">
					<button type="submit" class="flex-1 bg-green-600 hover:bg-green-700 text-white py-2 rounded transition">
						Rename
					</button>
					<button type="button" onclick="document.getElementById('rename-modal').classList.add('hidden')"
						class="flex-1 bg-gray-600 hover:bg-gray-700 text-white py-2 rounded transition">
						Cancel
					</button>
				</div>
			</form>
		</div>
	</div>
}

script showRenameModal(path string, currentName string) {
	document.getElementById('rename-old-path').value = path;
	document.getElementById('rename-new-name').value = currentName;
	document.getElementById('rename-modal').classList.remove('hidden');
}

func formatFileSize(size int64, isDir bool) string {
	if isDir {
		return "-"
	}
	if size > 1048576 {
		return fmt.Sprintf("%.1f MB", float64(size)/1048576)
	}
	if size > 1024 {
		return fmt.Sprintf("%.1f KB", float64(size)/1024)
	}
	return fmt.Sprintf("%d B", size)
}
