package servers

import (
	"github.com/sneakykiwi/gs-panel/internal/models"
	"github.com/sneakykiwi/gs-panel/views/components"
	"github.com/sneakykiwi/gs-panel/views/layouts"
)

templ TemplateConfigPage(server *models.Server, user *models.User, yamlContent string) {
	@layouts.Base("Template Config - " + server.Name, user) {
		<div class="flex h-screen">
			@components.Sidebar(user)

			<main class="flex-1 p-8 overflow-hidden flex flex-col">
				<div class="mb-6">
					<a href={ templ.URL("/servers/" + server.ID) } class="text-gray-400 hover:text-white text-sm">
						← Back to Server
					</a>
				</div>

				<div class="flex justify-between items-center mb-6">
					<div>
						<h1 class="text-3xl font-bold">Template Configuration</h1>
						<p class="text-gray-400">{ server.Name } ({ server.GameType })</p>
					</div>
					<div class="flex items-center gap-2">
						<span class="text-sm text-gray-400">Version:</span>
						<span class="bg-gray-700 px-2 py-1 rounded text-sm">{ server.TemplateVersion }</span>
					</div>
				</div>

				<div class="bg-yellow-500/10 border border-yellow-500/50 text-yellow-200 px-4 py-3 rounded mb-6 flex-shrink-0">
					<div class="flex items-start gap-3">
						<svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
						</svg>
						<div>
							<p class="font-medium">Read-Only View</p>
							<p class="text-sm text-yellow-200/80">This configuration is stored with your server and cannot be edited directly. To change the template, use the "Upgrade Template" feature which will migrate your settings to a newer template version while preserving your customizations like port, memory, and environment variables.</p>
						</div>
					</div>
				</div>

				<div class="bg-gray-800 rounded-lg border border-gray-700 flex flex-col flex-1 min-h-0">
					<div class="flex items-center justify-between px-4 py-3 border-b border-gray-700 flex-shrink-0">
						<span class="text-sm font-medium text-gray-300">template.yaml</span>
						<button
							type="button"
							onclick="navigator.clipboard.writeText(templateEditor.getValue())"
							class="text-xs text-gray-400 hover:text-white transition flex items-center gap-1"
						>
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
							</svg>
							Copy
						</button>
					</div>
					<textarea id="yaml-content" class="hidden">{ yamlContent }</textarea>
					<div id="yaml-editor-container" class="flex-1"></div>
				</div>

				<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.12/codemirror.min.css"/>
				<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.12/theme/dracula.min.css"/>
				<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.12/codemirror.min.js"></script>
				<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.12/mode/yaml/yaml.min.js"></script>
				@templateViewerScript()
			</main>
		</div>
	}
}

script templateViewerScript() {
	var templateEditor = CodeMirror(document.getElementById("yaml-editor-container"), {
		value: document.getElementById("yaml-content").value,
		lineNumbers: true,
		mode: "yaml",
		theme: "dracula",
		readOnly: true,
		viewportMargin: Infinity
	});

	templateEditor.setSize("100%", "100%");
}

