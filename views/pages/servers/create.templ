package servers

import (
	"fmt"
	"github.com/sneakykiwi/gs-panel/internal/models"
	"github.com/sneakykiwi/gs-panel/internal/services"
	"github.com/sneakykiwi/gs-panel/views/components"
	"github.com/sneakykiwi/gs-panel/views/layouts"
)

templ CreatePage(user *models.User, templates []services.GameTemplate, errorMsg string) {
	@layouts.Base("Create Server", user) {
		<div class="flex h-screen">
			@components.Sidebar(user)

			<main class="flex-1 p-8 overflow-auto">
				<div class="max-w-2xl mx-auto">
					<h1 class="text-3xl font-bold mb-8">Create New Server</h1>

					if errorMsg != "" {
						<div class="bg-red-500/20 border border-red-500 text-red-300 px-4 py-3 rounded mb-6">
							{ errorMsg }
						</div>
					}

					<form method="POST" action="/servers" class="bg-gray-800 rounded-lg p-6 border border-gray-700">
						@components.CsrfToken()
						<div class="mb-6">
							<label class="block text-sm font-medium mb-2" for="name">Server Name</label>
							<input type="text" id="name" name="name" required
								class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded focus:outline-none focus:border-blue-500"
								placeholder="My Minecraft Server"/>
						</div>

						<div class="mb-6" x-data="{selected: ''}">
							<label class="block text-sm font-medium mb-2">Game</label>
							<div class="grid grid-cols-2 gap-3">
								for _, t := range templates {
									<label class="cursor-pointer">
										<input type="radio" name="game_type" value={ t.ID } class="sr-only peer" required
											x-on:change={ fmt.Sprintf("selected = '%s'", t.ID) }/>
										<div class="p-4 bg-gray-700 border border-gray-600 rounded hover:border-blue-500 peer-checked:border-blue-500 peer-checked:bg-blue-500/10 transition">
											<p class="font-medium">{ t.Name }</p>
											<p class="text-sm text-gray-400">Port: { fmt.Sprintf("%d", t.DefaultPort) }</p>
										</div>
									</label>
								}
							</div>
						</div>

						<div class="mb-6">
							<label class="block text-sm font-medium mb-2" for="memory_limit">Memory Limit (MB)</label>
							<input type="number" id="memory_limit" name="memory_limit" min="512" step="256"
								class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded focus:outline-none focus:border-blue-500"
								placeholder="2048"/>
							<p class="text-sm text-gray-400 mt-1">Leave empty for game default</p>
						</div>

						<div class="mb-6">
							<label class="block text-sm font-medium mb-2" for="port">Port</label>
							<input type="number" id="port" name="port" min="1024" max="65535"
								class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded focus:outline-none focus:border-blue-500"
								placeholder="Leave empty for game default"/>
							<p class="text-sm text-gray-400 mt-1">Leave empty for game default</p>
						</div>

						<div class="flex gap-4">
							<button type="submit"
								class="flex-1 bg-green-600 hover:bg-green-700 text-white font-medium py-2 px-4 rounded transition">
								Create Server
							</button>
							<a href="/"
								class="flex-1 bg-gray-600 hover:bg-gray-700 text-white font-medium py-2 px-4 rounded transition text-center">
								Cancel
							</a>
						</div>
					</form>
				</div>
			</main>
		</div>
	}
}
